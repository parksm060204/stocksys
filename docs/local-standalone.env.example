# Current supported runtime: local in-memory database with durable snapshots.
# Copy the required values into your deployment environment; do not commit secrets.
NEXT_PUBLIC_USE_IN_MEMORY=true
NEXT_PUBLIC_DISABLE_GUEST_AUTH=true
STOCKSYS_DATA_DIR=.data
NEXTAUTH_URL=https://your-domain.example
# Set NEXTAUTH_SECRET to a securely generated secret in your secret manager.
# Google OAuth requires GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET there as well.
# A remote PostgreSQL URL is not needed for the local standalone runtime.
